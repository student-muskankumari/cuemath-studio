# ─── AI Text Generation ───────────────────────────────────────────────────────
# 1. Groq  → console.groq.com  (free, no credit card, fastest)
GROQ_API_KEY=gsk_REPLACE_ME

# 2. Gemini → aistudio.google.com  (free, no credit card)
GEMINI_API_KEY=AIza_REPLACE_ME

# 3. Mistral → console.mistral.ai  (free tier)
MISTRAL_API_KEY=REPLACE_ME

# ─── AI Image Generation ─────────────────────────────────────────────────────
# OPTION A (RECOMMENDED): Together AI — Free $25 credit, no card needed
# Sign up: https://together.ai → API Keys → Create key
# Model: FLUX.1-schnell-Free  (~2-3s, excellent quality, semantic alignment)
TOGETHER_API_KEY=REPLACE_ME

# OPTION B: HuggingFace — Free tier (slower, may time out)
# Sign up: https://huggingface.co → Settings → Access Tokens → New token (Read)
HUGGINGFACE_API_KEY=hf_REPLACE_ME

# ─── Image Fallback Chain (automatic, no extra keys needed) ──────────────────
# 1. Together AI FLUX.1-schnell  ← best, set TOGETHER_API_KEY above
# 2. HuggingFace SDXL-Turbo      ← free, decent quality
# 3. HuggingFace SDXL-base       ← free, slower
# 4. Pollinations flux-pro       ← free, no key needed
# 5. Pollinations flux           ← free fallback
# 6. Picsum Photos               ← always works (random photo)
