# ─── AI Text Generation ───────────────────────────────────────────────────────
# 1. Groq  → console.groq.com  (free, no credit card, fastest)
GROQ_API_KEY=gsk_REPLACE_ME

# 2. Gemini → aistudio.google.com  (free, no credit card)
GEMINI_API_KEY=AIza_REPLACE_ME

# 3. Mistral → console.mistral.ai  (free tier)
MISTRAL_API_KEY=REPLACE_ME

# ─── AI Image Generation ─────────────────────────────────────────────────────
# Pollinations → pollinations.ai → Sign in with GitHub → API Key
# Free pollen refills hourly, no card needed
POLLINATIONS_API_KEY=sk-REPLACE_ME

# HuggingFace → huggingface.co → Settings → Access Tokens → New token (Read)
# Free token, limited daily calls, no card needed
HUGGINGFACE_TOKEN=hf_REPLACE_ME

# ─── Image Fallback Chain (automatic) ────────────────────────────────────────
# 1. HuggingFace FLUX  ← uses HUGGINGFACE_TOKEN
# 2. Pollinations FLUX ← uses POLLINATIONS_API_KEY
# 3. Gradient fallback ← always works (brand-colored gradient)
